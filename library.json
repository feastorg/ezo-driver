{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "ezo-driver",
  "version": "0.7.1",
  "description": "Cross-platform Atlas Scientific EZO driver with explicit I2C/UART cores, shared control helpers, and typed product modules",
  "keywords": [
    "ezo",
    "i2c",
    "uart",
    "atlas scientific",
    "arduino"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/feastorg/ezo-driver.git"
  },
  "authors": [
    {
      "name": "Cameron K. Brooks",
      "email": "cambrooks3393@gmail.com",
      "maintainer": true
    },
    {
      "name": "Atlas Scientific"
    }
  ],
  "license": "MIT",
  "export": {
    "include": [
      "src",
      "examples/arduino",
      "README.md",
      "CHANGELOG.md",
      "LICENSE"
    ]
  },
  "frameworks": [
    "arduino"
  ],
  "platforms": "*",
  "headers": [
    "ezo.h",
    "ezo_calibration_transfer.h",
    "ezo_control.h",
    "ezo_do.h",
    "ezo_ec.h",
    "ezo_hum.h",
    "ezo_i2c.h",
    "ezo_i2c.hpp",
    "ezo_i2c_arduino_wire.h",
    "ezo_orp.h",
    "ezo_parse.h",
    "ezo_ph.h",
    "ezo_product.h",
    "ezo_rtd.h",
    "ezo_schema.h",
    "ezo_uart.h",
    "ezo_uart_arduino_stream.h"
  ]
}
